# =========================================================================== #
# Copy to .env and fill in your own credentials. NEVER commit .env.
# 复制为 .env 并填入你自己的凭证。切勿提交 .env。
# =========================================================================== #

# --------------------------------------------------------------------------- #
# Upstream mode: anthropic (official Messages API) | bedrock (Distill gateway)
# Auto-detected from UPSTREAM_BASE / DISTILL_* if unset.
# --------------------------------------------------------------------------- #
# UPSTREAM_MODE=anthropic

# --------------------------------------------------------------------------- #
# Option A — official Anthropic Messages API
# --------------------------------------------------------------------------- #
UPSTREAM_BASE=https://api.anthropic.com

# Your Anthropic API key (ANTHROPIC_API_KEY also accepted)
UPSTREAM_KEY=sk-ant-REPLACE-WITH-YOUR-KEY

# Model that returns thinking signatures
MODEL=claude-sonnet-4-6

# --------------------------------------------------------------------------- #
# Option B — Distill gateway (Tencent internal model-eval platform)
# Apply for an App ID / App Key at https://model-eval.woa.com/model/apply
# See docs/distill-gateway.md for routes, model ids and effort support.
# --------------------------------------------------------------------------- #
# UPSTREAM_MODE=bedrock
# UPSTREAM_BASE=http://api.model-eval.woa.com
# UPSTREAM_PROVIDER decides route + wire protocol:
#   aws_third            -> Bedrock invoke  POST /model/{MODEL}/invoke
#   anthropic | google   -> native Messages POST /v1/messages
# UPSTREAM_PROVIDER=aws_third
# DISTILL_APP_ID=REPLACE-WITH-YOUR-APP-ID
# DISTILL_APP_KEY=REPLACE-WITH-YOUR-APP-KEY
#
# Model examples (see docs/distill-gateway.md):
#   Opus 5   (adaptive):           MODEL=anthropic.claude-opus-5              EFFORT=max
#   Opus 4.8 (adaptive):           MODEL=anthropic.claude-opus-4-8            EFFORT=max
#   Fable 5  (always-on adaptive): MODEL=anthropic.claude-fable-5             EFFORT=max
#   Sonnet 4.5 (manual budget):    MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
#
# Optional: marker used ONLY in the Distill auth ?model= query, when the platform
# route alias differs from the invoke-URL model id.
# DISTILL_MODEL_MARKER=api_anthropic_claude-fable-5
# BEDROCK_ANTHROPIC_VERSION=bedrock-2023-05-31

# --------------------------------------------------------------------------- #
# Thinking controls. The request shape is chosen per model (see THINKING_MODE):
#   manual              -> thinking:{type:enabled, budget_tokens:N}
#                          (Sonnet/Opus 4.5, Claude 3.7)
#   adaptive            -> thinking:{type:adaptive, display} + output_config.effort
#                          (Opus 5/4.8/4.7/4.6, Sonnet 5/4.6)
#   always_on_adaptive  -> same shape, thinking always on (Fable 5, Mythos 5)
# Adaptive models reject budget_tokens with HTTP 400.
# --------------------------------------------------------------------------- #
# THINKING_MODE=auto            # auto | manual | adaptive | always_on_adaptive
# Adaptive effort: low | medium | high | xhigh | max
EFFORT=high
# Adaptive thinking display: omitted (seal into signature) | summarized
# THINKING_DISPLAY=omitted
# Manual-profile thinking budget only.
# THINKING_BUDGET=8000

# Max output tokens per request (raise for hard problems so reasoning isn't truncated)
MAX_TOKENS=64000

# Max chars accepted in the pasted-signature field. Signature length grows with the
# amount of hidden thinking, so keep this generous.
SIGNATURE_MAX_CHARS=200000

# Unseal dump: per-chunk output budget + auto-continuation rounds after max_tokens cuts
UNSEAL_CHUNK_TOKENS=8000
UNSEAL_MAX_CONTINUES=12
HTTP_TIMEOUT=1200

# Listen port
PORT=8000

# Per-IP daily quotas
PROVE_DAILY=20
LIVE_DAILY=40

# Where to write logs (conversation, signatures, raw responses). Gitignored.
LOG_DIR=./logs

# Optional: override per-model prices (USD per 1,000,000 tokens)
# PRICES_JSON={"claude-opus-4-8":{"input":15,"output":75},"claude-sonnet-4-6":{"input":3,"output":15}}
